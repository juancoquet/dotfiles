{
  "description": "Prime GitHub Issues guidance for dotfiles work",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "sh configs/agents/trackers/gh-issues/gh-issues-prime",
            "statusMessage": "Priming GitHub Issues"
          }
        ]
      }
    ]
  }
}
