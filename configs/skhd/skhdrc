# focus spaces
shift + ctrl - 1 : yabai -m space --focus 1
shift + ctrl - 2 : yabai -m space --focus 2
shift + ctrl - 3 : yabai -m space --focus 3
shift + ctrl - 4 : yabai -m space --focus 4
shift + ctrl - 5 : yabai -m space --focus 5
shift + ctrl - 6 : yabai -m space --focus 6
shift + ctrl - 7 : yabai -m space --focus 7
shift + ctrl - 8 : yabai -m space --focus 8
shift + ctrl - 9 : yabai -m space --focus 9
shift + ctrl - 0 : yabai -m space --focus 10

# send window to space + follow
shift + ctrl + cmd - 1 : yabai -m window --space 1; yabai -m space --focus 1
shift + ctrl + cmd - 2 : yabai -m window --space 2; yabai -m space --focus 2
shift + ctrl + cmd - 3 : yabai -m window --space 3; yabai -m space --focus 3
shift + ctrl + cmd - 4 : yabai -m window --space 4; yabai -m space --focus 4
shift + ctrl + cmd - 5 : yabai -m window --space 5; yabai -m space --focus 5
shift + ctrl + cmd - 6 : yabai -m window --space 6; yabai -m space --focus 6
shift + ctrl + cmd - 7 : yabai -m window --space 7; yabai -m space --focus 7
shift + ctrl + cmd - 8 : yabai -m window --space 8; yabai -m space --focus 8
shift + ctrl + cmd - 9 : yabai -m window --space 9; yabai -m space --focus 9
shift + ctrl + cmd - 0 : yabai -m window --space 10; yabai -m space --focus 10

# toggle layout (bsp <-> stack)
shift + ctrl - tab : ~/.config/yabai/toggle-layout.sh

# reorder windows (swap)
shift + ctrl + cmd - j : yabai -m window --swap next
shift + ctrl + cmd - k : yabai -m window --swap prev

# toggle ghostty width (1720 <-> 2560)
shift + ctrl - i : ~/.config/yabai/toggle-ghostty-width.sh

# toggle yabai (stop/start)
shift + ctrl + cmd - y : ~/.config/yabai/toggle-yabai.sh
