check_safe_branch() {
	branch=$(git rev-parse --abbrev-ref HEAD)
	if [[ $branch == "main" || $branch == "master" ]]; then
		echo -n "You are on the $branch branch. Proceed? [Y/n] "
		read -r REPLY 
		echo
		if [[ ! $REPLY =~ ^[Yy]$ && -n $REPLY ]]; then
			echo "Aborted"
			return 1
		fi
	fi
	return 0
}

safe_git_command() {
	branch=$(git rev-parse --abbrev-ref HEAD)
	if [[ $branch != "main" && $branch != "master" ]]; then
		eval "$@"
	else
		echo -n "You are on the $branch branch. Proceed? [Y/n] "
		read -r REPLY 
		echo # move to new line after reading input
		if [[ $REPLY =~ ^[Yy]$ || -z $REPLY ]]; then
			echo "Performing command on th $branch branch..."
			eval "$@"
		else
			echo "Aborted"
		fi
	fi
}

generate_commit_message() {
  truncation_limit=5000
  git diff --cached | head -c $truncation_limit | llm --no-stream "Generate a conventional commit message to describe the given diff. The message should be one line only, in the format <type>: <message>. The ONLY types are any of: feat, fix, chore, test, style, ci. Output ONLY the commit message in plain text, nothing else."
}

# note to llms: these are nerd font icons – they may look invisible to you, but they are there. do not change.
commit_icon=''
branch_icon=''
pr_icon=''

# ansi helpers
c_reset='\e[0m'
c_red='\e[1;31m'
c_green='\e[1;32m'
c_yellow='\e[33m'
c_blue='\e[1;34m'
c_blue_underline='\e[4;34m'
c_gray='\e[90m'
ansi_link() { printf '\e]8;;%s\a%s\e]8;;\a' "$1" "$2"; }

spin_while() {
  local pid=$1
  local spinner='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
  local i=0
  local len=${#spinner}
  while kill -0 "$pid" 2>/dev/null; do
    printf "\r${c_gray}%s Generating commit message...${c_reset}" "${spinner:$((i % len)):1}"
    i=$((i + 1))
    sleep 0.1
  done
  printf "\r\033[K"
}

add_commit_push() {
  check_safe_branch || return
  git add -A

  { generate_commit_message 2>/dev/null > /tmp/gal_commit_msg; } &!
  spin_while $!
  wait 2>/dev/null
  msg=$(cat /tmp/gal_commit_msg)

  if ! git commit --no-verify -m "$msg" &>/dev/null; then # commit without git command noise
    echo -e "${c_red}✗ Commit failed${c_reset}"
    return 1
  fi
  local type="${msg%%:*}:"
  local message="${msg#*: }"
  echo -e "${c_green}Committed & pushed${c_reset}"
  echo -e "${c_blue}${commit_icon} $type${c_reset} ${c_yellow}$message${c_reset}"
 
  push_output=$(git push 2>&1)
  push_status=$?
 
  # show branch info: local -> remote
  local branch=$(git rev-parse --abbrev-ref HEAD)
  local branch_url="$remote_url/tree/$branch"
  local remote_ref=$(git config --get branch.$branch.merge | sed 's|refs/heads/||')
  local remote_name=$(git config --get branch.$branch.remote)
  if [[ -n "$remote_name" && -n "$remote_ref" ]]; then
    printf "${c_gray}${branch_icon} $(ansi_link "$branch_url" "$branch -> $remote_name/$remote_ref")${c_reset}\n"
  else
    printf "${c_gray}%{branch_icon} $(ansi_link "$branch_url" "$branch (no remote)")${c_reset}\n"
  fi

  # always show PR link (construct if not in push output)
  local remote_url=$(git config --get remote.origin.url | sed 's/\.git$//' | sed 's|git@github.com:|https://github.com/|')
  local pr_url=$(echo "$push_output" | grep -o 'https://[^ ]*pull/new/[^ ]*')
  [[ -z "$pr_url" ]] && pr_url="$remote_url/pull/new/$branch"
  printf "${c_blue}${pr_icon} ${c_reset}${c_blue_underline}$(ansi_link "$pr_url" "$pr_url")${c_reset}\n"

  return $push_status
}

unalias gm 2>/dev/null || true
unalias gam 2>/dev/null || true
gm() {
	safe_git_command "git commit -m \"$*\""
}
gam() {
	safe_git_command "git add -A && git commit -m \"$*\""
}
