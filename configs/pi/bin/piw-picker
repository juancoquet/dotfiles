#!/usr/bin/env bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
	DIRECTORY="$(cd -P "$(dirname "$SOURCE")" && pwd)"
	SOURCE="$(readlink "$SOURCE")"
	[[ "$SOURCE" != /* ]] && SOURCE="$DIRECTORY/$SOURCE"
done
DOTFILES_DIR="$(cd "$(dirname "$SOURCE")/../../.." && pwd)"
exec node --experimental-strip-types "$DOTFILES_DIR/packages/pi-workspace-manager/src/picker.ts" "$@"
